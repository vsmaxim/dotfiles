{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "tray",
    "cpu",
    "memory",
    "disk",
    "network",
    "pulseaudio",
    "battery",
    "hyprland/language"
  ],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "all-outputs": true,
    "sort-by-number": true
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 60,
    "separate-outputs": true
  },

  "hyprland/language": {
    "format": "{}",
    "format-en": "us",
    "format-ru": "ru"
  },

  "clock": {
    "interval": 5,
    "format": " {:%A %d-%m-%y %R}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },

  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "states": {
      "warning": 50,
      "critical": 90
    }
  },

  "memory": {
    "interval": 5,
    "format": " {used:0.1f}G/{total:0.1f}G"
  },

  "disk": {
    "interval": 30,
    "format": " {free}",
    "path": "/",
    "states": {
      "warning": 80,
      "critical": 90
    }
  },

  "network": {
    "format-wifi": " {essid}",
    "format-ethernet": " {ipaddr}",
    "format-disconnected": "⚠ off",
    "tooltip-format": "{ifname} via {gwaddr}",
    "on-click": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " mute",
    "format-icons": {
      "default": ["", "", ""]
    },
    "scroll-step": 5,
    "on-click": "pamixer -t",
    "on-click-right": "pavucontrol"
  },

  "battery": {
    "interval": 30,
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "states": {
      "warning": 30,
      "critical": 15
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}
